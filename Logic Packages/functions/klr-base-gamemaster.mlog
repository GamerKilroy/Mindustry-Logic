# Manages the gamestate, initializes waypoints, requests cutscenes and more.

setrate 500
set WMEM processor1 # Link to ram
draw triangle WMEM_ADDR WMEMBUFF_IN WMEMBUFF_LEN WMEMBUFF_OUT ramACK d1

sensor managedTeam @this @team

set baseUnitMemoryAddr 1000 #Base memory addresses for stack pointer refresh
set baseUnitMemoryLen 5500
set baseSquadMemoryAddr 7000
set baseSquadMemoryLen 13000

op sub unitHeapTotal baseUnitMemoryLen baseUnitMemoryAddr
op sub squadHeapTotal baseSquadMemoryLen baseSquadMemoryAddr

jump noCyclic equal @second lastSecond #1Hz Rising Edge
    op add reti @counter 1
    jump cyclic1Hz always 0 0
    set lastsecond @second
noCyclic:

jump noNewWave equal @waveNumber lastWaveNumber #Wave Change Rising Edge
    op add reti @counter 1
    jump cyclicNewWave always 0 0 
    set lastWaveNumber @waveNumber
noNewWave:

op add reti @counter 1
jump resetPointers equal doResetPointers true

op add reti @counter 1
jump manageTouch always 0 0

op add reti @counter 1
jump drawScreen always 0 0

jump gameInit equal gamestate 0 #Write all INIT data to ROM
jump beforeGameStart equal gamestate 1 #Difficulty selection & Game Start
jump runningConfig equal gamestate 2 #Load difficulty data to RAM
jump gameStarted equal gamestate 3 #Gametime checks

end

gameInit:

    set gameDifficulty 1

    setprop @buildSpeed @clientUnit -1
    setrule buildSpeed 0 @sharded

    set WMEM_ADDR 8
    set WMEMBUFF_IN baseUnitMemoryAddr
    op add reti @counter 1
    jump doWMEMwrite always 0 0

    set WMEM_ADDR 9
    set WMEMBUFF_IN baseUnitMemoryLen
    op add reti @counter 1
    jump doWMEMwrite always 0 0

    set WMEM_ADDR 10
    set WMEMBUFF_IN baseSquadMemoryAddr
    op add reti @counter 1
    jump doWMEMwrite always 0 0

    set WMEM_ADDR 11
    set WMEMBUFF_IN baseSquadMemoryLen
    op add reti @counter 1
    jump doWMEMwrite always 0 0

    op add reti @counter 1 

    set WMEM_ADDR 0
    set WMEMBUFF_IN true
    op add reti @counter 1
    jump doWMEMwrite always 0 0
    set gamestate 1
    end

beforeGameStart:
    setprop @buildSpeed @clientUnit -1
    setrule buildSpeed 0 @sharded
    setrule currentWaveTime 300

    op floor secMod @second
    op mod secMod secMod 2
    jump mission1text equal secMod 0
    jump mission2text equal secMod 1

    mission1text:
        print "Wave timer inactive"
        message mission 1
        jump textDoneBGS always 0 0 
        

    mission2text:
        print "Select difficulty and START"
        message mission 1
        jump textDoneBGS always 0 0

    textDoneBGS:
    end

runningConfig:

    set WMEM_ADDR 50
    set WMEMBUFF_IN @nova
    op add reti @counter 1
    jump doWMEMwrite always 0 0

    jump doneConfig equal gameDifficulty 0 # Below for Normal and above
    jump doneConfig equal gameDifficulty 1 # Below for Hard and above
    jump doneConfig equal gameDifficulty 2 # Below for Erad and above
    jump doneConfig equal gameDifficulty 3 # Below for RUNIC

    doneConfig:

    setprop @buildSpeed @clientUnit 1
    setrule buildSpeed 1 @sharded

    set gamestate 3
    setprop @health display1 0
    print "Configuration data written. Game is starting, have fun!"
    message toast 4
end

gameStarted:

    op mod secToNext @waveTime 60
    op floor secToNext secToNext
    op idiv minToNext @waveTime 60

    select secFixer lessThan secToNext 10 "0" ""

    print "[#EEEEEE]Next Wave: {0}:{6}{1}s\n"

    read currUnitHeapHead cell1 1
    read currSquadHeapHead cell1 3

    op sub currUnitHeapHead currUnitHeapHead baseUnitMemoryAddr
    op sub currSquadHeapHead currSquadHeapHead baseSquadMemoryAddr
    op div unitMemoryUsage currUnitHeapHead unitHeapTotal
    op div squadMemoryUsage currSquadHeapHead squadHeapTotal
    op floor unitMemoryUsageINT unitMemoryUsage 1
    op floor squadMemoryUsageINT squadMemoryUsage 1
    op mul unitMemoryUsageDEC unitMemoryUsage 100
    op mul squadMemoryUsageDEC unitMemoryUsage 100
    op floor unitMemoryUsageDEC unitMemoryUsageDEC
    op floor squadMemoryUsageDEC squadMemoryUsageDEC

    print "[#55ff55]uMEM: {2}.{3}%\n"
    print "[#2299ff]sMEM: {4}.{5}%\n"

    format minToNext
    format secToNext
    format unitMemoryUsageINT
    format unitMemoryUsageDEC
    format squadMemoryUsageINT
    format squadMemoryUsageDEC
    format secFixer

    message mission 1
    
end

resetPointers:
    write baseUnitMemoryAddr cell1 1
    write baseSquadMemoryAddr cell1 3
    set doResetPointers equal false
set @counter reti

drawScreen:

    packcolor GREEN_BRIGHT 0 1 0.8 1
    packcolor GREEN_DARK 0 1 0.8 0.2

    packcolor YELLOW_BRIGHT 0 1 0 1
    packcolor YELLOW_DARK 0 1 0 0.2

    packcolor RED_BRIGHT 0.8 0.8 0 1
    packcolor RED_DARK 0.8 0.8 0 0.2

    packcolor PURPLE_BRIGHT 1 0 0 1
    packcolor PURPLE_DARK 1 0 0 0.2

    packcolor RUNIC_BANNER 1 0 1 1

    packcolor IS_SELECTED 1 1 1 0.5

    draw clear 20 20 20
    jump noRunicBG notEqual gameDifficulty 4
    draw clear 70 10 30
    draw stroke 5
    draw color 110 15 40
    draw line 13 0 13 80
    draw line 18 0 18 80
    draw line 30 0 30 80
    draw line 48 0 48 80
    draw line 70 0 70 80
    draw stroke 2
    draw color 50 15 90
    draw line 17 0 17 80
    draw line 55 0 55 80
    draw stroke 4
    draw line 65 0 65 80
    packcolor COLOR_SELECTED 150 150 150 1
    noRunicBG:
    draw stroke 2
    draw color 0 0 0 255

    

    draw col GREEN_DARK
    jump easyColorNotSelected notEqual gameDifficulty 0
        jump easyColorNotSelected equal gameDifficulty 4
        set COLOR_SELECTED GREEN_BRIGHT
        draw col IS_SELECTED
    easyColorNotSelected:
    draw rect 1 40 18 25
    draw col GREEN_BRIGHT
    draw lineRect 1 40 18 25
    #draw line 12 96 34 158  

    draw col YELLOW_DARK
    jump normalColorNotSelected notEqual gameDifficulty 1
        jump normalColorNotSelected equal gameDifficulty 4
        set COLOR_SELECTED YELLOW_BRIGHT
        draw col IS_SELECTED
    normalColorNotSelected:
    draw rect 21 40 18 25
    draw col YELLOW_BRIGHT
    draw lineRect 21 40 18 25
    #draw line 58 96 76 158 
    #draw line 62 96 80 158

    draw col RED_DARK
    jump hardColorNotSelected notEqual gameDifficulty 2
        jump hardColorNotSelected equal gameDifficulty 4
        set COLOR_SELECTED RED_BRIGHT
        draw col IS_SELECTED
    hardColorNotSelected:
    draw rect 41 40 18 25 
    draw col RED_BRIGHT
    draw lineRect 41 40 18 25 
    #draw line 88 96 106 154 
    #draw line 92 92 110 158
    #draw line 96 96 114 154

    draw col PURPLE_DARK
    jump eradColorNotSelected notEqual gameDifficulty 3
        jump eradColorNotSelected equal gameDifficulty 4
        set COLOR_SELECTED PURPLE_BRIGHT
        draw col IS_SELECTED
    eradColorNotSelected:
    draw rect 61 40 18 25
    draw col PURPLE_BRIGHT
    draw lineRect 61 40 18 25
    #draw line 128 96 146 154 
    #draw line 132 92 150 158
    #draw line 136 96 154 154
    #draw line 126 160 156 90

    jump skipBanner equal gameDifficulty 4
        draw stroke 20
        draw col COLOR_SELECTED
        draw line 0 80 80 80
    skipBanner:

    draw col COLOR_SELECTED
    draw stroke 2
    draw lineRect 7 7 65 26
    print "START"
    draw print 38 22 @center
    draw col 80 80 80
    draw rect 7 7 65 26

    jump noRunicFG notEqual gameDifficulty 4
        draw stroke 20
        draw color 255 0 255
        draw line 40 20 20 20
        draw line 20 20 20 40
        draw line 40 60 60 60
    noRunicFG:

    drawflush display1
set @counter reti

doWMEMread: #WMEM Read - Read from RAM Address
    waitForReadyRead:
    read isBusy WMEM "isBusy"
    jump waitForReadyRead equal isBusy true
    read isBusy WMEM "isBusy"
    jump waitForReadyRead equal isBusy true
    write true WMEM "isBusy"
    write @this WMEM "ACKtarget"
    write WMEM_ADDR WMEM "addr"
    write WMEMBUFF_IN WMEM "inbuffer"
    write 1 WMEM "req"
    waitACKRead: ; jump waitACKRead equal ramACK 0
    set ramACK 0
set @counter reti

doWMEMwrite: #WMEM Write - Write to RAM Address
    waitForReadyWrite:
    read isBusy WMEM "isBusy"
    jump waitForReadyWrite equal isBusy true
    read isBusy WMEM "isBusy"
    jump waitForReadyWrite equal isBusy true
    write true WMEM "isBusy"
    write @this WMEM "ACKtarget"
    write WMEM_ADDR WMEM "addr"
    write WMEMBUFF_IN WMEM "inbuffer"
    write 2 WMEM "req"
    waitACKWrite: ; jump waitACKWrite equal ramACK 0
    set ramACK 0
set @counter reti

manageTouch:
    sensor touchXbase display1 @x #base display touch calculation
    sensor touchYbase display1 @y
    sensor mouseX @clientUnit @shootX
    sensor mouseY @clientUnit @shootY
    op sub touchXbase touchXbase 1
    op sub touchYbase touchYbase 1
    op sub touchX mouseX touchXbase
    op sub touchY mouseY touchYbase
    op div pixTouchX touchX 3
    op div pixTouchY touchY 3
    op mul pixTouchX pixTouchX 96
    op mul pixTouchY pixTouchY 96

    sensor isShooting @clientUnit @shooting

    jump noShootFront equal isShooting lastShooting
        jump noShootFront equal isShooting false
            set FPshoot true
            jump endShootFront always 0 0
    noShootFront:
        set FPshoot false
    endShootFront:
        set lastShooting isShooting

    jump noTouchInput equal FPshoot false

        jump notDifficultyInput greaterThan pixTouchY 60
        jump notDifficultyInput lessThan pixTouchY 37

        jump noTouchInput lessThan pixTouchX 0
        jump easyDifficultyChange lessThan pixTouchX 17
        jump mediumDifficultyChange lessThan pixTouchX 35
        jump hardDifficultyChange lessThan pixTouchX 53
        jump eradDifficultyChange lessThan pixTouchX 70
        jump runicDifficultyChange greaterThan pixTouchX 200
        jump notDifficultyInput always 0 0


        easyDifficultyChange:
            set gameDifficulty 0
            print "[#009999]Easy Difficulty Selected. [#ffffff]Most OB-AI are off. Little extra enemy spawns. "
            message toast 2
            jump doneDifficultyChange always 0 0

        mediumDifficultyChange:
            set gameDifficulty 1
            print "[#00FF00]Medium Difficulty Selected. [#ffffff]Default OB-AI configuration. Standard extra enemy spawns."
            message toast 2
            jump doneDifficultyChange always 0 0

        hardDifficultyChange:
            set gameDifficulty 2
            print "[#999900]Hard Difficulty Selected. [#ffffff]All OB-AI are active. Extra enemy spawns also activate by time. Guardians have more mechanics."
            message toast 2
            jump doneDifficultyChange always 0 0

        eradDifficultyChange:
            set gameDifficulty 3
            print "[#FF0000]ERADICATION difficulty selected. [#ffffff]All OB_AI are active. Extra Enemy spawns are harder and do not respect wave timer. Guardians are much tougher and have even more mechanics"
            message toast 3
            jump doneDifficultyChange always 0 0

        runicDifficultyChange:
            jump notDifficultyInput greaterThan pixTouchX 220
            op add runicTicks runicTicks 1
            jump notEnoughRunicTicks lessThan runicTicks 3
                set gameDifficulty 4
                set COLOR_SELECTED RUNIC_BANNER
                print "[#990099] ᑽᒀᑹᑳᑩ DIFFICULTY DISCOVERED. [#ffffff]Good luck."
                message toast 4
                jump doneDifficultyChange always 0 0
            notEnoughRunicTicks:
            print "Click..."
            message toast 1
            jump doneDifficultyChange always 0 0

    notDifficultyInput:
    doneDifficultyChange:

        jump notStartInput greaterThan pixTouchY 25
        jump notStartInput lessThan pixTouchY 0
        jump notStartInput greaterThan pixTouchX 70
        jump notStartInput lessThan pixTouchX 10

        set gamestate 2

    notStartInput:
    noTouchInput:

set @counter reti

cyclic1Hz:
    fetch unitCount activeUnits managedTeam 0 0
    op equal doResetPointers activeUnits 0


set @counter reti

cyclicNewWave:
    set doResetPointers true
set @counter reti