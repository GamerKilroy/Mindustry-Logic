# Base Unit Module and Example

setrate 500
set TARGET_UNIT @flare

set WMEM processor1   #RAM Initialization - Do not touch
draw triangle WMEM_ADDR WMEMBUFF_IN WMEMBUFF_LEN WMEMBUFF_OUT ramACK d1

set SQUADLOOKUP cell1 #Squad Lookup Initialization
set SQUADID_CAN_JOIN 0x0008
set SQUADID_CAN_LEAD 0x0008

set coreWeight 1    # Set the weights. Lower = Less Likely. 0 = Never. Set it high enough and it will ignore closer targets if needed.
set turretWeight 1  # For instance, genWeight=5 turretWeight=1 means it needs to be 5 times closer to a turret than a generator to target it.
set genWeight 1     # However if the turrets do get close enough, it will still switch to turrets - If you didn't turn it off, that is.
set factWeight 1    # Default has all at 1, meaning it will target everything equally.
set reactWeight 1
set unitWeight 1

set weaponRange 10      # Main weapon range, this you want to use against buildings. Will be used for big units too.
set PDSRange 10         # PDS weapons range, where available. This is the range at which you want to shoot at most units.
set PDSThreshold 500    # If the Target Enemy Unit has more Max HP than this threshold, then it will use main weapons calculations, not PDS.
# At the default of 500, you start hitting T2 ground units with main, and T3 air units with main.

read baseUnitMemoryAddr WMEM "baseUnitMemoryAddr"
read baseSquadMemoryAddr WMEM "baseSquadMemoryAddr"
ubind TARGET_UNIT ## Binds to the unit handle.

jump hasUnit notEqual @unit null #If there is no unit to control, just end.
end
hasUnit:

sensor bitpackR @unit @flag    # Read flag from currently bound unit and unpack it.

op idiv SQUADADDR bitpackR 10000000

op idiv ADDR bitpackR 10
op mod ADDR ADDR 1000000
 
op mod FLAG bitpackR 10

op greaterThan hasRAM ADDR 0

jump init equal FLAG 0    # If the unit does not have a memory space yet, initialize
jump roaming equal FLAG 1

end

init:

    jump noRam equal WMEM null  
 
        sensor unitType @unit @type                    #Lookup in Logic Units if this unit type is enabled.
        set WMEM_ADDR 50
        set WMEMBUFF_IN unitType
        set WMEMBUFF_LEN 50
        op add reti @counter 1
        jump doWMEMlookup always 0 0
        jump noRam equal WMEMBUFF_OUT -1 #If disabled, act as if no RAM is available   

        set WMEMBUFF_LEN 1
        op add reti @counter 2 #Otherwise, ask for variable allocation and receive back your ADDR  
        jump doWMEMmalloc always 0 0
        set reti 0

        set ADDR WMEMBUFF_OUT

        op mul bitpack ADDR 10                 #Calculate new bitpacked flag, set it, and set ADDR for this cycle.
        op add bitpack bitpack 1
        
        ucontrol flag bitpack

        set WMEM_ADDR ADDR                     #Write yourself in memory at your address
        set WMEMBUFF_IN @unit
        op add reti @counter 2
        jump doWMEMwrite always 0 0
        set reti 0

    end
 
noRam:
    ucontrol flag 1 #In absence of RAM, we only use FLAG. 
end

roaming:
    jump controlKAI equal hasRAM false
    jump controlOBAI equal hasRAM true
    end
 
    controlKAI:         # This unit has no RAM available, so it will use a simpler logic based on FLAG. Default KAI logic, normally.

        op add reti @counter 2    # Call target finding function
        jump targetFind always 0 0
        set reti 0

        ##### uControl and shooting manager
        jump hasCommand greaterThan maxWeight 0    # If somehow there is no target (core is not on the map?) just stop...? Usually a configuration mistake (coreWeight = 0?)
        ucontrol stop
        end
        hasCommand:  

        jump usePDSRange equal isPDSMode true          # Use PDS weapon range for small unit attacks

        ucontrol within targetX targetY weaponRange hasLOF  #If in range of main weapon, shoot
        jump outOfRange equal hasLOF false
        set doShoot true
        outOfRange:

        usePDSRange:
        ucontrol within targetX targetY PDSRange hasLOF   #if in range of PDS, shoot
        jump outOfRangePDS equal hasLOF false
        set doShoot true
        outOfRangePDS:

        jump rotateToCore equal doShoot false
        ucontrol targetp currTarget doShoot   
        jump doMovement always 0 0
        rotateToCore:
        ucontrol target coreX coreY 0

        doMovement: 

        # Insert specific basic unit movement here
        ucontrol approach 0 0 0
    end

    controlOBAI:        #If you're an OBAI unit, look for a squad to join. There should usually be one unless all leaders are dead.
        op add reti @counter 2
        jump squadProcedure always 0 0
        set reti 0

    roamingOBAI:        #If you're not part of a squad, still try to use your RAM to your best potential.
        set 0 0         ####################### CUSTOM RAM ROAMING CODE HERE
    end 

    leadSquad:          #If you're the leader, you're expected to do more!
        ucontrol move 0 0       ####################### CUSTOM SQUAD LEADER LOGIC HERE
    end

    followSquad:        #Otherwise, just follow orders.
         ucontrol move 20 0         ####################### COMMAND CHANNEL LOGIC HERE
    end


##### FUNCTIONS BELOW - CALL BY SETTING ARGS THEN op reti add @counter +2 then jump to function always.
doWMEMread: #WMEM Read - Read from RAM Address
    waitForReadyRead:
    read isBusy WMEM "isBusy"
    jump waitForReadyRead equal isBusy true
    read isBusy WMEM "isBusy"
    jump waitForReadyRead equal isBusy true
    write true WMEM "isBusy"
    write @this WMEM "ACKtarget"
    write WMEM_ADDR WMEM "addr"
    write WMEMBUFF_IN WMEM "inbuffer"
    write 1 WMEM "req"
    waitACKRead: ; jump waitACKRead equal ramACK 0
    set ramACK 0
set @counter reti

doWMEMwrite: #WMEM Write - Write to RAM Address
    waitForReadyWrite:
    read isBusy WMEM "isBusy"
    jump waitForReadyWrite equal isBusy true
    read isBusy WMEM "isBusy"
    jump waitForReadyWrite equal isBusy true
    write true WMEM "isBusy"
    write @this WMEM "ACKtarget"
    write WMEM_ADDR WMEM "addr"
    write WMEMBUFF_IN WMEM "inbuffer"
    write 2 WMEM "req"
    waitACKWrite: ; jump waitACKWrite equal ramACK 0
    set ramACK 0
set @counter reti

doWMEMlookup: #WMEM Lookup Target - Look for a value in RAM, define start and len.
    waitForReadyLookup:
    read isBusy WMEM "isBusy"
    jump waitForReadyLookup equal isBusy true
    read isBusy WMEM "isBusy"
    jump waitForReadyLookup equal isBusy true
    write true WMEM "isBusy"
    write @this WMEM "ACKtarget"
    write WMEM_ADDR WMEM "addr"
    write WMEMBUFF_IN WMEM "inbuffer"
    write WMEMBUFF_LEN WMEM "reqLen"
    write 4 WMEM "req"
    waitACKLookup: ; jump waitACKLookup equal ramACK 0
    set ramACK 0
set @counter reti

doWMEMmalloc: #WMEM Allocate Memory - Ask for a place in unit memory, get ADDR back.

    waitForReadyMalloc:
    read isBusy WMEM "isBusy"
    jump waitForReadyMalloc equal isBusy true
    read isBusy WMEM "isBusy"
    jump waitForReadyMalloc equal isBusy true
    write true WMEM "isBusy"
    write @this WMEM "ACKtarget"
    write WMEM_ADDR WMEM "addr"
    write WMEMBUFF_IN WMEM "inbuffer"
    write WMEMBUFF_LEN WMEM "reqLen"
    write 10 WMEM "req"
    waitACKMalloc: ; jump waitACKMalloc equal ramACK 0
    set ramACK 0
set @counter reti

doSquadSearch: #SquadSearch function. Will look for squads with a Valid ID to join.
    set i 0
    set VALID_SQUADS 0
    continueSquadSearch:
        op mul cellAddr i 2
        read squadNumber SQUADLOOKUP cellAddr  #Read from Squad Cell each even data slot

        jump noSquadHereSearch equal squadNumber 0 #There is no squad in the slow, jump to next
        
            op and accepts squadNumber SQUADID_CAN_JOIN    #Check if you can join this squad type

            jump SquadNotAcceptedSearch equal accepts false #If you cannot, jump to next
                op add thisSquadCellAddr cellAddr 1     #Otherwise, read the Leader from RAM
                read squadLookupMemoryAddr SQUADLOOKUP thisSquadCellAddr

                set WMEM_ADDR squadLookupMemoryAddr # #Lookup the Leader in RAM
                set reti2 reti
                op add reti @counter 2
                jump doWMEMread always 0 0
                set reti2 0
                set reti reti2

                set u_leader WMEMBUFF_OUT # Find the leader position and range
                sensor leaderX u_leader @x 
                sensor leaderY u_leader @y
                sensor leaderRange u_leader @range
                ucontrol within leaderX leaderY 30 closeToLeader

                jump tooFarFromLeader notEqual closeToLeader true
                op add VALID_SQUADS VALID_SQUADS 1 #If it's a valid squad, add it to the counter

            SquadNotAcceptedSearch:
            tooFarFromLeader:
        noSquadHereSearch:
        op add i  i 1
    jump continueSquadSearch lessThan i 32 #Loop through all 32 squads.
set @counter reti
    
doJoinSquad: #SquadJoin function. Will join the selected # squad.
    set i 0
    set squadCounter 0
    continueSquadJoin: #Iterate through squads as for squadSearch
        op mul cellAddr i 2
        read squadNumber SQUADLOOKUP cellAddr

        jump noSquadHereJoin equal squadNumber 0
        
            op and accepts squadNumber SQUADID_CAN_JOIN

            jump SquadNotAcceptedJoin equal accepts false   #Keep count of the valid squads, when it maches, request to join
                op and accepts squadNumber SQUADID_CAN_LEAD

                jump reachedJoinable equal squadCounter squadToJoin
                op add squadCounter squadCounter 1

            SquadNotAcceptedJoin:

        noSquadHereJoin:
        op add i i 1
    jump continueSquadJoin lessThan i 32

    set @counter reti

    reachedJoinable: #Once you have reached the correct squad number, join it
        set aa_reachedJoinable true
        op add squadAddrLocation cellAddr 1
        read squadAddrLocation SQUADLOOKUP squadAddrLocation

        op add lUnitSquadAddrSaved ADDR 1
        set WMEM_ADDR lUnitSquadAddrSaved
        set WMEMBUFF_IN squadAddrLocation

        set reti2 reti   #And save it's location in RAM in your unit memory space
        op add reti @counter 2
        jump doWMEMwrite always 0 0
        set reti2 0
        set reti reti2

        jump notSergeant equal canJoinAsSergeant false
            op add i squadAddrLocation 64
            op add endSergListAddr i 64
            

            iterateSergList:
                set WMEM_ADDR i

                set reti2 reti
                op add reti @counter 2
                jump doWMEMread always 0 0
                set reti2 0
                set reti reti2

                jump notFree notEqual WMEMBUFF_OUT null
                    set WMEMBUFF_IN @unit

                    set reti2 reti
                    op add reti @counter 2
                    jump doWMEMwrite always 0 0
                    set reti2 0
                    set reti reti2

                    jump sergeantDone always 0 0

                notFree:

                op add i i 1
            jump iterateSergList lessThan i endSergListAddr

        sergeantDone:
        notSergeant:

        set SQUADADDR squadAddrLocation   # And in the Unit's flag.
        sensor originalBitpack @unit @flag
        op mul toAdd SQUADADDR 10000000
        op add newBitpack toAdd originalBitpack
        ucontrol flag newBitpack

set @counter reti

doCreateSquad: #SquadCreate function. Initializes all needed memory for Squad creation.

    set aa_didcreate true

    set WMEMBUFF_LEN 2 #Request a Squad Malloc
    set reti2 reti
    op add reti @counter 2
    jump doWMEMmalloc always 0 0
    set reti2 0
    set reti reti2

    set triedCreate true
    set receivedSquadAddr WMEMBUFF_OUT

    set SQUADADDR WMEMBUFF_OUT #set your own squad address

    op sub cellSpace SQUADADDR baseSquadMemoryAddr
    op idiv cellSpace cellSpace 64 #Calculate the correct cell space based on assigned memory location

    set WMEMBUFF_IN true   #Claim the memory as Valid
    op add WMEM_ADDR SQUADADDR 3
    set reti2 reti
    op add reti @counter 2
    jump doWMEMwrite always 0 0
    set reti2 0
    set reti reti2

    set WMEMBUFF_IN @unit   #Write your own reference in RAM as a Leader
    set WMEM_ADDR SQUADADDR
    set reti2 reti
    op add reti @counter 2
    jump doWMEMwrite always 0 0
    set reti2 0
    set reti reti2

    set writtenToSquad SQUADADDR

    op add personalSquadAddr ADDR 1  #Write it in your own memory as well
    set WMEM_ADDR personalSquadAddr
    set WMEMBUFF_IN SQUADADDR
    set reti2 reti
    op add reti @counter 2
    jump doWMEMwrite always 0 0
    set reti2 0
    set reti reti2

    set writtenToUnit SQUADADDR

    op add personalIsLeader ADDR 2  #As well as saving that you're the leader!
    set WMEM_ADDR personalIsLeader
    set WMEMBUFF_IN @unit
    set reti2 reti
    op add reti @counter 2
    jump doWMEMwrite always 0 0
    set reti2 0
    set reti reti2

    set markedAsLeader true

    set reti2 reti
    op add reti @counter 2
    jump doWMEMwrite 
    set reti2 0 sa
    set reti reti2

    set writtenLeadToUnit true


    write SQUADID_CAN_LEAD SQUADLOOKUP cellSpace # Publish the Advert in the Squad Memory Cell
    op add cellSpace cellSpace 1
    write WMEMBUFF_OUT SQUADLOOKUP cellSpace

    set advertCreate true

    sensor originalBitpack @unit @flag #Update your own flag
    op mul toAdd SQUADADDR 10000000
    op add newBitpack toAdd originalBitpack
    ucontrol flag newBitpack    

    set createFlagWritten true
    
set @counter reti
    
targetFind: #OLD RoamingDefault is now a targetFinding function. Will look for valid targets based on weighted distance.
    ulocate building core true @copper coreX coreY isCore b_core #Locate the enemy core
    ulocate building turret true @copper turretX turretY isTurret b_turret #find the closest enemy turret
    ulocate building generator true @copper genX genY isGenerator b_generator #find the closest enemy generator
    ulocate building factory true @copper factX factY isFactory b_factory #find the closest enemy factory
    ulocate building reactor true @copper reactX reactY isReactor b_reactor #find the closest enemy reactor
    uradar enemy any any distance 0 1 enemyUnit #See if there are enemy units


    ##### CALCULATIONS
    set maxWeight 0     # Reset the values for this cycle
    set isPDSMode false

    sensor hereX @unit @x    # Find the current unit position
    sensor hereY @unit @y

    jump noCore equal coreWeight 0
    jump noCore equal isCore false
    op sub aX coreX hereX     # Calculate weighted distance to Core
    op pow aXsq aX 2
    op sub bY hereY coreY
    op pow bYsq bY 2
    op add c2 aXsq bYsq
    op sqrt coreDist c2 c2
    op div coreDist 1 coreDist 
    op mul coreScaled coreDist coreWeight
    jump coreNotHighest lessThan coreScaled maxWeight
    set currTarget b_core
    set targetX coreX
    set targetY coreY
    set maxWeight coreScaled
    noCore:
    set coreScaled 0
    coreNotHighest:

    jump noTurret equal turretWeight 0
    jump noTurret equal isTurret false
    op sub aX turretX hereX     # Calculate weighted distance to Turret
    op pow aXsq aX 2
    op sub bY hereY turretY
    op pow bYsq bY 2
    op add c2 aXsq bYsq
    op sqrt turretDist c2 c2
    op div turretDist 1 turretDist 
    op mul turretScaled turretDist turretWeight
    jump turretNotHighest lessThan turretScaled maxWeight
    set currTarget b_turret
    set targetX turretX
    set targetY turretY
    set maxWeight turretScaled
    noTurret:
    set turretScaled 0
    turretNotHighest:

    jump noGen equal genWeight 0
    jump noGen equal isGenerator false
    op sub aX genX hereX      # Calculate weighted distance to Generator
    op pow aXsq aX 2
    op sub bY hereY genY
    op pow bYsq bY 2
    op add c2 aXsq bYsq
    op sqrt genDist c2 c2
    op div genDist 1 genDist 
    op mul genScaled genDist genWeight
    jump genNotHighest lessThan genScaled maxWeight
    set currTarget b_generator
    set targetX genX
    set targetY genY
    set maxWeight genScaled
    noGen:
    set genScaled 0
    genNotHighest:
    
    jump noFact equal factWeight 0
    jump noFact equal isFactory false
    op sub aX factX hereX       # Calculate weighted distance to Factory
    op pow aXsq aX 2
    op sub bY hereY factY
    op pow bYsq bY 2
    op add c2 aXsq bYsq
    op sqrt factDist c2 c2
    op div factDist 1 factDist 
    op mul factScaled factDist factWeight
    jump factNotHighest lessThan factScaled maxWeight
    set currTarget b_factory
    set targetX factX
    set targetY factY
    set maxWeight factScaled
    noFact:
    set factScaled 0
    factNotHighest:

    jump noReact equal reactWeight 0
    jump noReact equal isReactor false
    op sub aX reactX hereX       # Calculate weighted distance to Reactor
    op pow aXsq aX 2
    op sub bY hereY reactY
    op pow bYsq bY 2
    op add c2 aXsq bYsq
    op sqrt reactDist c2 c2
    op div reactDist 1 reactDist 
    op mul reactScaled reactDist reactWeight
    jump reactNotHighest lessThan reactScaled maxWeight
    set currTarget b_reactor
    set targetX reactX
    set targetY reactY
    set maxWeight reactScaled
    noReact:
    set reactScaled 0
    reactNotHighest:

    jump noUnit equal enemyUnit null
    op sub aX unitX hereX        # Calculate weighted distance to enemy units
    op pow aXsq aX 2
    op sub bY hereY unitY
    op pow bYsq bY 2
    op add c2 aXsq bYsq
    op sqrt unitDist c2 c2
    op div unitDist 1 unitDist 
    op mul unitScaled unitDist unitWeight
    jump unitNotHighest lessThan unitScaled maxWeight
    set currTarget enemyUnit
    set targetX unitX
    set targetY unitY
    set maxWeight unitScaled
    sensor unitMaxHP enemyUnit @maxHealth  # If the enemy unit has less HP than the PDS threshold, it will use PDS ranges - This way it won't fire slow main weapons at a faraway flare.
    jump bigEnough greaterThan unitMaxHP PDSThreshold
    set isPDSMode true 
    noUnit:
    set unitScaled 0
    bigEnough:
    unitNotHighest:
set @counter reti

squadProcedure:  #Special "FUNCTION" that will manage squad search join and create but does not reti. Will instead directly jump to the proper control group.
        wait 0.001

        set aa_lookLeader true

        op add isLeaderAddr ADDR 2   # If you're the leader, then lead - Don't follow!
        set WMEM_ADDR isLeaderAddr
        op add reti @counter 2
        jump doWMEMread always 0 0
        set reti 0

        set aa_lookLeaderDone true
        set aa_isLeader WMEMBUFF_OUT

        jump leadSquad equal WMEMBUFF_OUT @unit 

        jump followSquad greaterThan SQUADADDR 0    # If you have a squad already, do not roam.
        
            set aa_trySearch true
            op add reti @counter 2                  # Search for valid squads
            jump doSquadSearch always 0 0
            set reti 0

            set squadToJoin 0

            set aa_tryJoin true

            jump noValidSquads equal VALID_SQUADS 0 # If there are 0 squads, try to create one
            jump onlyOneValid equal VALID_SQUADS 1 # If there is only one, then join that
                op div scale  1 VALID_SQUADS       # Otherwise roll for which one to join
                op rand RNGroll 1
                op div RNGroll scale 
                op floor RNGroll RNGroll 0

                set aa_RNGroll true

                set squadToJoin RNGroll

            onlyOneValid:

                set aa_oneJoin true
                op add reti @counter 2                  # Request to join the correct Squad
                jump doJoinSquad always 0 0
                set reti 1

            end

            noValidSquads:        
            
                set aa_create true                  # If there are no valid squads, check if this unit can lead.
                jump cannotLead lessThan SQUADID_CAN_LEAD 1 #If no, just do RoamingOBAI

                op add reti @counter 2                # Otherwise, call the squad creation function
                jump doCreateSquad always 0 0
                set reti 1
            
            end

            cannotLead:

            jump roamingOBAI always 0 0    ## If there is no squad and cannot create one, then just do RoamingOBAI logic.
        end
    end