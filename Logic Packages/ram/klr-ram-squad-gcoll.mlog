# Unit Table garbage collector. wProc running at low intensity, scanning Dynamic Memory for units
# Read or Write requests get in via remote commands write to the following variable:
setrate 500

set WMEM processor1   #RAM Initialization - Do not touch
draw triangle WMEM_ADDR WMEMBUFF_IN WMEMBUFF_LEN WMEMBUFF_OUT ramACK d1
read baseSquadMemoryAddr WMEM "baseSquadMemoryAddr"
read baseSquadMemoryLen WMEM "baseSquadMemoryLen"

jump noValidInit equal WMEM 0
jump noValidInit equal baseSquadMemoryAddr 0
jump noValidInit equal baseSquadMemoryLen 0

set currPointer baseSquadMemoryAddr
op add maxSquadMemory baseSquadMemoryAddr baseSquadMemoryLen

continueGC: #Repeat until end of memory

    set WMEM_ADDR currPointer #Read @dead from currently pointed unit
    op add reti @counter 1
    jump doWMEMread always 0 0
    jump isValid equal WMEMBUFF_OUT null
    op add WMEM_ADDR currPointer 3
    op add reti @counter 1
    jump doWMEMread always 0 0
    jump isValid equal WMEMBUFF_OUT true

    set WMEMBUFF_LEN 128
    op add reti @counter 1 #If unit is dead, delete that memory
    jump doWMEMfree always 0 0

    isValid:

    op add currPointer currPointer 128 #Get the next unit slot, then iterate
    jump continueGC lessThan currPointer maxSquadMemory


noValidInit:

end

#Functions below

doWMEMread: #WMEM Read - Read from RAM Address
    waitForReadyRead:
    read isBusy WMEM "isBusy"
    jump waitForReadyRead equal isBusy true
    read isBusy WMEM "isBusy"
    jump waitForReadyRead equal isBusy true
    write true WMEM "isBusy"
    write @this WMEM "ACKtarget"
    write WMEM_ADDR WMEM "addr"
    write WMEMBUFF_IN WMEM "inbuffer"
    write 1 WMEM "req"
    waitACKRead: ; jump waitACKRead equal ramACK 0
    set ramACK 0
set @counter reti

doWMEMwrite: #WMEM Write - Write to RAM Address
    waitForReadyWrite:
    read isBusy WMEM "isBusy"
    jump waitForReadyWrite equal isBusy true
    read isBusy WMEM "isBusy"
    jump waitForReadyWrite equal isBusy true
    write true WMEM "isBusy"
    write @this WMEM "ACKtarget"
    write WMEM_ADDR WMEM "addr"
    write WMEMBUFF_IN WMEM "inbuffer"
    write 2 WMEM "req"
    waitACKWrite: ; jump waitACKWrite equal ramACK 0
    set ramACK 0
set @counter reti

doWMEMfree: #WMEM Free Memory - Clean Vars from starting ADDR

    waitForReadyFree:
    read isBusy WMEM "isBusy"
    jump waitForReadyFree equal isBusy true
    read isBusy WMEM "isBusy"
    jump waitForReadyFree equal isBusy true
    write true WMEM "isBusy"
    write @this WMEM "ACKtarget"
    write WMEM_ADDR WMEM "addr"
    write WMEMBUFF_IN WMEM "inbuffer"
    write WMEMBUFF_LEN WMEM "reqLen"
    write 11 WMEM "req"
    waitACKFree: ; jump waitACKFree equal ramACK 0
    set ramACK 0
set @counter reti
