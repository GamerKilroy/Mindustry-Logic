# Main Ram Manager for Kilroy Logic. Will initialize linking to processor and not busy.
# Read or Write requests get in via remote commands write to the following variable:
# req = 0 - Do nothing
#       1 - Read Request
#       2 - Write Request
#       3 - Lookup Request
#       4 - Targetted Lookup Request
#
# The memory address to read/write from can be found in the following variable
# addr = The position in RAM to read or write
#
# The value for Write can be found in the following variable:
# inbuffer = The value that will be written to memory
#
# The entity that will receive a response can be provided by the following variable:
# ACKtarget = The @unit or @building that will receive the ACK.
# Note - The remotes will receive ACK via the ramACK variable, written by this.
#
# reqLen is used for targetted lookup, specifying the number of position to search after the defined ADDR.
#
# Before populating any requests, units should check if the core is busy.
# isBusy is set to true whenever the RAM is in the middle of writing or reading.
# Will be automatically set to false when the current operation is done.

set baseUnitMemoryAddr 1000
set baseUnitMemoryLen 3900
set baseSquadMemoryAddr 7000
set baseSquadMemoryLen 3700
draw triangle ACKtarget lastACKtarget p1 p2 p3 p4

jump doInit equal doneInit 0
jump memread equal req 1
jump memwrite equal req 2
jump memlookup equal req 3
jump memlookuptarget equal req 4
jump malloc equal req 10
jump free equal req 11
jump fullReset equal req 99
end

doInit:
    set RAMLOOKUP processor1
    read maxRAM RAMLOOKUP maxRAM
    set ROMLOOKUP processor2
    set POINTERCELL cell1
    set unitMemoryPointer baseUnitMemoryAddr
    op add maxUnitMemory baseUnitMemoryLen baseUnitMemoryAddr
    set squadMemoryPointer baseSquadMemoryAddr
    op add maxSquadMemory squadMemoryPointer baseSquadMemoryLen

    set doneInit true

doReset:
    set lasreq req
    set req 0

    set lastaddr addr
    set addr 0

    set lastbuffer inbuffer
    set inbuffer 0

    set lastACKtarget ACKtarget

    set lastreqlen reqLen
    set reqLen 0

    write 1 ACKtarget "ramACK"
    set isBusy 0
    set doneInit true

    end

memread:
    set isBusy true #Set processor as busy
    setrate 500
    op mod ramvnameidx addr 6000 #Get the memory address IN the ram
    op idiv ramprocidx addr 6000 #Get the number of the memory bank
    lookup block vname ramprocidx #Lookup to convert to String + Name
    sensor vname vname @name
    read RAMref RAMLOOKUP vname #From the Processor RAMLOOKUP, obtain a Link to the memory holder
    op idiv romprocidx ramvnameidx 261 #Once you know the bank, find the correct ROM storage for said location.
    lookup block vname romprocidx #Lookup to convert to String + Name
    sensor vname vname @name
    read ROMref ROMLOOKUP vname #From the Processor ROMLOOKUP, obtain a Link to the correct ROM bank.
    op mod vnameidxinrom ramvnameidx 261 #Obtain the specific position in the ROM table.
    lookup block vnameforromblock vnameidxinrom #Lookup to convert to String
    sensor vnameforrom vnameforromblock @name 
    read actualvarname ROMref vnameforrom #Read from ROM the proper variable name in RAM.
    read value RAMref actualvarname #Read from RAM the Variable Value

    write value ACKtarget "WMEMBUFF_OUT"
     #Send the Variable Value to the ACKtarget

    jump doReset always 0 0
end

memwrite:
    set isBusy true #Set processor as busy
    setrate 500
    op mod ramvnameidx addr 6000 #Get the memory address IN the ram
    op idiv ramprocidx addr 6000 #Get the number of the memory bank
    lookup block vname ramprocidx #Lookup to convert to String + Name
    sensor vname vname @name
    read RAMref RAMLOOKUP vname #From the Processor RAMLOOKUP, obtain a Link to the memory holder
    op idiv romprocidx ramvnameidx 261 #Once you know the bank, find the correct ROM storage for said location.
    set testing1 true
    lookup block vname romprocidx #Lookup to convert to String + Name
    sensor vname vname @name
    set testing2 true
    read ROMref ROMLOOKUP vname #From the Processor ROMLOOKUP, obtain a Link to the correct ROM bank.
    op mod vnameidxinrom ramvnameidx 261 #Obtain the specific position in the ROM table.
    lookup block vnameforromblock vnameidxinrom #Lookup to convert to String
    sensor vnameforrom vnameforromblock @name 
    read actualvarname ROMref vnameforrom #Read from ROM the proper variable name in RAM.
    write inbuffer RAMref actualvarname #Write the variable to memory.
    set testing3 true
    #write 1 ACKtarget "ramACK" #Confirm write to ACKtarget
    set isBusy false #Write completed, remove busy return to normal IPT.
    set testing4 true
    jump doReset always 0 0
end

memlookup:
    set isBusy true
    set i 0
    setrate 500
    continueLookup:
        op mod ramvnameidx i 6000 #Get the memory address IN the ram
        op idiv ramprocidx i 6000 #Get the number of the memory bank
        lookup block vname ramprocidx #Lookup to convert to String + Name
        sensor vname vname @name
        read RAMref RAMLOOKUP vname #From the Processor RAMLOOKUP, obtain a Link to the memory holder
        op idiv romprocidx ramvnameidx 261 #Once you know the bank, find the correct ROM storage for said location.
        lookup block vname romprocidx #Lookup to convert to String + Name
        sensor vname vname @name
        read ROMref ROMLOOKUP vname #From the Processor ROMLOOKUP, obtain a Link to the correct ROM bank.
        op mod vnameidxinrom ramvnameidx 261 #Obtain the specific position in the ROM table.
        lookup block vnameforromblock vnameidxinrom #Lookup to convert to String
        sensor vnameforrom vnameforromblock @name 
        read actualvarname ROMref vnameforrom #Read from ROM the proper variable name in RAM.
        read currLookup RAMref actualvarname
        jump lookupDone equal currLookup inbuffer
        op add i 1
        jump continueLookup lessThan i maxRAM
        set currLookup -1
        jump lookupDone equal currLookup inbuffer
    end

    lookupDone:
    
    write i ACKtarget "WMEMBUFF_OUT"
    #write 1 ACKtarget "ramACK"
    jump doReset always 0 0

memlookuptarget:
    set isBusy true
    set i addr
    op add maxLookup addr reqLen
    setrate 500
    continueLookupTarget:
        op mod ramvnameidx i 6000 #Get the memory address IN the ram
        op idiv ramprocidx i 6000 #Get the number of the memory bank
        lookup block vname ramprocidx #Lookup to convert to String + Name
        sensor vname vname @name
        read RAMref RAMLOOKUP vname #From the Processor RAMLOOKUP, obtain a Link to the memory holder
        op idiv romprocidx ramvnameidx 261 #Once you know the bank, find the correct ROM storage for said location.
        lookup block vname romprocidx #Lookup to convert to String + Name
        sensor vname vname @name
        read ROMref ROMLOOKUP vname #From the Processor ROMLOOKUP, obtain a Link to the correct ROM bank.
        op mod vnameidxinrom ramvnameidx 261 #Obtain the specific position in the ROM table.
        lookup block vnameforromblock vnameidxinrom #Lookup to convert to String
        sensor vnameforrom vnameforromblock @name 
        read actualvarname ROMref vnameforrom #Read from ROM the proper variable name in RAM.
        read currLookup RAMref actualvarname
        jump lookupDone equal currLookup inbuffer
        op add i 1
        jump continueLookupTarget lessThan i maxLookup
        set i -1
        jump lookupTargetDone equal currLookup inbuffer
    end

    lookupTargetDone:
   
    write i ACKtarget "WMEMBUFF_OUT"
    #write 1 ACKtarget "ramACK"

    jump doReset always 0 0
end

malloc:
    set isBusy true
    jump unitMalloc equal reqLen 1
    jump squadMalloc equal reqLen 2
    jump doReset always 0 0 

    unitMalloc:
        jump outOfMemory greaterThan unitMemoryPointer maxUnitMemory

        waitForStackUnit:
        sensor stackBusy POINTERCELL 0
        jump waitForStackUnit equal stackBusy 1

        write 1 POINTERCELL 0
        read unitMemoryPointer POINTERCELL 1
        op add newUnitMemoryPointer unitMemoryPointer 16
        write newUnitMemoryPointer POINTERCELL 1
        write 0 POINTERCELL 0

        write unitMemoryPointer ACKtarget "WMEMBUFF_OUT"
        write 1 ACKtarget "ramACK"
        jump doReset always 0 0

    squadMalloc:
        jump outOfMemory greaterThan unitMemoryPointer maxUnitMemory

        waitForStackSquad:
        sensor stackBusy POINTERCELL 2
        jump waitForStackUnit equal stackBusy 1

        write 1 POINTERCELL 2
        read squadMemoryPointer POINTERCELL 3
        op add newSquadMemoryPointer squadMemoryPointer 128
        write newSquadMemoryPointer POINTERCELL 3
        write 0 POINTERCELL 2

        write squadMemoryPointer ACKtarget "WMEMBUFF_OUT"
        #write 1 ACKtarget "ramACK"
        jump doReset always 0 0

    outOfMemory:
        write -1 ACKtarget "WMEMBUFF_OUT"
        #write 1 ACKtarget "ramACK"
        jump doReset always 0 0
end

free:
    set isBusy true
    set i addr
    op add freeSize addr reqLen
    setrate 500
    continueFree:
        op mod ramvnameidx i 6000 #Get the memory address IN the ram
        op idiv ramprocidx i 6000 #Get the number of the memory bank
        lookup block vname ramprocidx #Lookup to convert to String + Name
        sensor vname vname @name
        read RAMref RAMLOOKUP vname #From the Processor RAMLOOKUP, obtain a Link to the memory holder
        op idiv romprocidx ramvnameidx 261 #Once you know the bank, find the correct ROM storage for said location.
        lookup block vname romprocidx #Lookup to convert to String + Name
        sensor vname vname @name
        read ROMref ROMLOOKUP vname #From the Processor ROMLOOKUP, obtain a Link to the correct ROM bank.
        op mod vnameidxinrom ramvnameidx 261 #Obtain the specific position in the ROM table.
        lookup block vnameforromblock vnameidxinrom #Lookup to convert to String
        sensor vnameforrom vnameforromblock @name 
        read actualvarname ROMref vnameforrom #Read from ROM the proper variable name in RAM.
        write null RAMref actualvarname
        op add i 1
        jump continueFree lessThan i freeSize
   
    #write 1 ACKtarget "ramACK"

    jump doReset always 0 0
end

fullReset:
    set isBusy true
    set i 0
    setrate 500
    continueFullReset:
        op mod ramvnameidx i 6000 #Get the memory address IN the ram
        op idiv ramprocidx i 6000 #Get the number of the memory bank
        lookup block vname ramprocidx #Lookup to convert to String + Name
        sensor vname vname @name
        read RAMref RAMLOOKUP vname #From the Processor RAMLOOKUP, obtain a Link to the memory holder
        op idiv romprocidx ramvnameidx 261 #Once you know the bank, find the correct ROM storage for said location.
        lookup block vname romprocidx #Lookup to convert to String + Name
        sensor vname vname @name
        read ROMref ROMLOOKUP vname #From the Processor ROMLOOKUP, obtain a Link to the correct ROM bank.
        op mod vnameidxinrom ramvnameidx 261 #Obtain the specific position in the ROM table.
        lookup block vnameforromblock vnameidxinrom #Lookup to convert to String
        sensor vnameforrom vnameforromblock @name 
        read actualvarname ROMref vnameforrom #Read from ROM the proper variable name in RAM.
        write null RAMref actualvarname
        op add i 1
        jump continueFullReset lessThan i maxRAM
   
    #write 1 ACKtarget "ramACK"

    jump doReset always 0 0
end