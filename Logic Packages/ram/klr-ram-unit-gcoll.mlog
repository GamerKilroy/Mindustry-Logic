# Unit Table garbage collector. wProc running at low intensity, scanning Dynamic Memory for units
# Read or Write requests get in via remote commands write to the following variable:

set baseUnitMemoryAddr 1000 #BASE Dynamic Memory Parameters
set baseUnitMemoryLen 3900
set baseSquadMemoryAddr 7000
set baseSquadMemoryLen 3700

set currPointer baseUnitMemoryAddr # Start the pointer for the start of memory

op add reti @counter 1 #INIT function call
jump doInit always 0 0

op equal parity RAMLOOKUP false #Verify integrity, if false reboot
op add parity parity ROMLOOKUP
jump noValidInit notEqual parity null

continueGC: #Repeat until end of memory

    set addr currPointer #Read @dead from currently pointed unit
    op add reti @counter 1
    jump memread always 0 0
    sensor isAlive WMEMreturn @dead
    jump isValid equal isAlive true

    op add reti @counter 1 #If unit is dead, delete that memory
    jump memdel always 0 0

    isValid:

    op add currPointer currPointer 16 #Get the next unit slot, then iterate
    jump continueGC lessThan currPointer maxUnitMemory


noValidInit:

end

#Functions below

doInit: #Link to RAMLOOKUP and ROMLOOKUP, as well as calculating max memory areas.
    set RAMLOOKUP processor1
    read maxRAM RAMLOOKUP maxRAM
    set ROMLOOKUP processor2
    set unitMemoryPointer baseUnitMemoryAddr
    op add maxUnitMemory unitMemoryPointer baseUnitMemoryAddr
    set squadMemoryPointer baseSquadMemoryAddr
    op add maxSquadMemory squadMemoryPointer baseSquadMemoryLen
    set @counter reti

memread: #Delete 16 vars from memory, in sequence from addr.
    setrate 500
    op mod ramvnameidx addr 6000 #Get the memory address IN the ram
    op idiv ramprocidx addr 6000 #Get the number of the memory bank
    lookup block vname ramprocidx #Lookup to convert to String + Name
    sensor vname vname @name
    read RAMref RAMLOOKUP vname #From the Processor RAMLOOKUP, obtain a Link to the memory holder
    op idiv romprocidx ramvnameidx 261 #Once you know the bank, find the correct ROM storage for said location.
    lookup block vname romprocidx #Lookup to convert to String + Name
    sensor vname vname @name
    read ROMref ROMLOOKUP vname #From the Processor ROMLOOKUP, obtain a Link to the correct ROM bank.
    op mod vnameidxinrom ramvnameidx 261 #Obtain the specific position in the ROM table.
    lookup block vnameforromblock vnameidxinrom #Lookup to convert to String
    sensor vnameforrom vnameforromblock @name 
    read actualvarname ROMref vnameforrom #Read from ROM the proper variable name in RAM.
    read value RAMref actualvarname #Read from RAM the Variable Value

    set WMEMreturn value

    set @counter reti
end

memdel:
    setrate 500

    op add endOfUnit addr 16

    continueDel:

        op mod ramvnameidx addr 6000 #Get the memory address IN the ram
        op idiv ramprocidx addr 6000 #Get the number of the memory bank
        lookup block vname ramprocidx #Lookup to convert to String + Name
        sensor vname vname @name
        read RAMref RAMLOOKUP vname #From the Processor RAMLOOKUP, obtain a Link to the memory holder
        op idiv romprocidx ramvnameidx 261 #Once you know the bank, find the correct ROM storage for said location.
        lookup block vname romprocidx #Lookup to convert to String + Name
        sensor vname vname @name
        read ROMref ROMLOOKUP vname #From the Processor ROMLOOKUP, obtain a Link to the correct ROM bank.
        op mod vnameidxinrom ramvnameidx 261 #Obtain the specific position in the ROM table.
        lookup block vnameforromblock vnameidxinrom #Lookup to convert to String
        sensor vnameforrom vnameforromblock @name 
        read actualvarname ROMref vnameforrom #Read from ROM the proper variable name in RAM.
        write null RAMref actualvarname #Read from RAM the Variable Value

        op add addr addr 1
        jump continueDel lessThan addr endOfUnit

    set WMEMreturn 0
    set @counter reti
end