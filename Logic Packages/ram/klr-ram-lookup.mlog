setrate 200

set graphite-press "/A"
set multi-press ":A"
set silicon-smelter "<A"
set silicon-crucible "=A"
set kiln ">A"
set plastanium-compressor "?A"
set phase-weaver "AA"
set cryofluid-mixer "BA"

set i 0
set numlink @links
repeat:
lookup block vname i 
sensor vname vname @name
getlink vlink i
write vlink @this vname
op add i i 1
jump repeat lessThan i @links
op mul maxRAM @links 6000
stop